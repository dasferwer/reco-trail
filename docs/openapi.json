      "get": {
        "tags": [
          "Recommendations"
        ],
        "summary": "Recommendations",
        "operationId": "recommendations_recommendations_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          },
          {
            "name": "algorithm",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "auto",
                "popularity",
                "content",
                "collaborative",
                "hybrid"
